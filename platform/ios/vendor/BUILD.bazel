load("//bazel:flags.bzl", "WARNING_FLAGS")

objc_library(
    name = "SMCalloutView",
    srcs = glob([
        "SMCalloutView/*.m",
    ]),
    hdrs = glob([
        "SMCalloutView/*.h",
    ]),

    includes = ["SMCalloutView"],

    # Compile options: WARNING_FLAGS["ios"] plus target architecture
    copts = WARNING_FLAGS["ios"] + [
        "-target", "arm64-apple-ios11.0",   # use arm64 for device, simulator can override with bazel flag
        "-fobjc-arc",
    ],

    # Link against UIKit
    sdk_frameworks = ["UIKit"],

    tags = ["manual"],
    visibility = [
        "//platform:__pkg__",
        "//platform/ios:__pkg__",
    ],
)
