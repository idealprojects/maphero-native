load("//bazel:flags.bzl", "WARNING_FLAGS")

objc_library(
    name = "SMCalloutView",
    srcs = glob([
        "SMCalloutView/*.m",
    ]),
    hdrs = glob([
        "SMCalloutView/*.h",
    ]),

    includes = ["SMCalloutView"],

    copts = WARNING_FLAGS["ios"] + [
        "-target", "arm64-apple-ios11.0",
        "-isysroot", "$(APPLE_SDK_ROOT)",
        "-F$(APPLE_SDK_ROOT)/System/Library/Frameworks",
    ],

    sdk_frameworks = ["UIKit"],
    sdk_includes = ["UIKit"],

    tags = ["manual"],
    visibility = [
        "//platform:__pkg__",
        "//platform/ios:__pkg__",
    ],
)
